---
// One template renders every section list page (/projects/, /essays/, ...).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Footer from '../../components/Footer.astro';
import { sections, type Section } from '../../data/site';

export function getStaticPaths() {
  return sections.map((section) => ({ params: { section: section.slug }, props: { section } }));
}

const { section } = Astro.props as { section: Section };
const all = await getCollection(section.slug);
// The "★ Page description" entry supplies the intro line and is not listed.
const pageEntry = all.find((e) => e.id === 'page-description');
const intro = pageEntry?.data.summary ?? section.intro;
const entries = all
  .filter((e) => e.id !== 'page-description' && !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={section.title} description={intro}>
  <div class="page">
    <SectionHeader current={section.slug} />

    <main class="main">
      <div class="title-row">
        <span class="label accent">{section.num}</span>
        <h1 class="display page-title">{section.title}</h1>
      </div>
      <p class="intro">{intro}</p>

      {entries.length === 0 ? (
        <div class="empty label muted">Coming soon</div>
      ) : (
        <ol class="list">
          {entries.map((e) => (
            <li>
              <a href={`/${section.slug}/${e.id}/`}>
                <span class="label muted">{e.data.date.getFullYear()}</span>
                <span class="entry-title">{e.data.title}</span>
                {e.data.summary && <span class="summary">{e.data.summary}</span>}
              </a>
            </li>
          ))}
        </ol>
      )}
    </main>

    <Footer />
  </div>
</Base>

<style>
  .main { flex: 1; display: flex; flex-direction: column; gap: 24px; }
  .title-row { display: flex; align-items: baseline; gap: 20px; padding-bottom: 20px; border-bottom: 2px solid var(--color-rule); }
  .page-title { font-size: var(--size-page-title); line-height: 0.9; }
  .intro { margin: 0; max-width: var(--max-text); }
  .empty { margin-top: 24px; padding: 48px 0; border-top: 1px solid var(--color-rule-soft); border-bottom: 1px solid var(--color-rule-soft); }

  .list { list-style: none; margin: 24px 0 0; padding: 0; border-top: 1px solid var(--color-rule); }
  .list a {
    display: grid; grid-template-columns: 80px minmax(0, 1fr) minmax(0, 1fr);
    gap: 8px 24px; align-items: baseline;
    padding: 18px 0; border-bottom: 1px solid var(--color-rule-soft);
  }
  .entry-title { font-family: var(--font-display); font-weight: var(--weight-subhead); font-size: 24px; line-height: 1.2; }
  .summary { color: var(--color-muted); }
  @media (max-width: 720px) {
    .list a { grid-template-columns: 1fr; }
  }
</style>
