---
// One template renders every section list page (/projects/, /essays/, ...).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Footer from '../../components/Footer.astro';
import EntryList, { type Item } from '../../components/EntryList.astro';
import { sections, type Section } from '../../data/site';

export function getStaticPaths() {
  return sections.map((section) => ({ params: { section: section.slug }, props: { section } }));
}

const { section } = Astro.props as { section: Section };
const all = await getCollection(section.slug);
// The "★ Page description" entry supplies the intro line and is not listed.
const pageEntry = all.find((e) => e.id === 'page-description');
const intro = pageEntry?.data.summary ?? section.intro;
const entries = all.filter((e) => e.id !== 'page-description' && !e.data.draft);

const toItem = (e: (typeof entries)[number]): Item => ({
  href: `/${section.slug}/${e.id}/`, date: e.data.date, title: e.data.title, summary: e.data.summary,
});
const byDate = (a: Item, b: Item) => b.date.valueOf() - a.date.valueOf();

// Essays page: two groups. Writing (incl. imported Substack posts) and Research, by `category`.
let groups: { heading?: string; items: Item[] }[];
if (section.slug === 'essays') {
  const writing = entries.filter((e) => e.data.category !== 'research').map(toItem).sort(byDate);
  const research = entries.filter((e) => e.data.category === 'research').map(toItem).sort(byDate);
  groups = [{ heading: 'Research', items: research }, { heading: 'Personal writing', items: writing }];
} else {
  groups = [{ items: entries.map(toItem).sort(byDate) }];
}
---
<Base title={section.title} description={intro}>
  <div class="page">
    <SectionHeader current={section.slug} />

    <main class="main">
      <div class="title-row">
        <span class="label accent">{section.num}</span>
        <h1 class="display page-title">{section.title}</h1>
      </div>
      <p class="intro">{intro}</p>
      {groups.map((g) => <EntryList heading={g.heading} items={g.items} showSummary={section.slug !== 'essays'} />)}
    </main>

    <Footer />
  </div>
</Base>

<style>
  .main { flex: 1; display: flex; flex-direction: column; gap: 24px; }
  .title-row { display: flex; align-items: baseline; gap: 20px; padding-bottom: 20px; border-bottom: 2px solid var(--color-rule); }
  .page-title { font-size: var(--size-page-title); line-height: 0.9; }
  .intro { margin: 0; max-width: var(--max-text); }
</style>
