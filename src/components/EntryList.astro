---
// A list of entries: local pages or external links (e.g. Substack).
export interface Item {
  href: string;
  date: Date;
  title: string;
  summary?: string;
  external?: boolean;
}
interface Props { items: Item[]; heading?: string; emptyText?: string }
const { items, heading, emptyText = 'Coming soon' } = Astro.props;
---
<section class="group">
  {heading && <h2 class="label group-heading">{heading}</h2>}
  {items.length === 0 ? (
    <div class="empty label muted">{emptyText}</div>
  ) : (
    <ol class="list">
      {items.map((e) => (
        <li>
          <a href={e.href} {...(e.external ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="label muted">{e.date.getFullYear()}</span>
            <span class="entry-title">{e.title}{e.external && <span class="ext" aria-label="(opens Substack)"> ↗</span>}</span>
            {e.summary && <span class="summary">{e.summary}</span>}
          </a>
        </li>
      ))}
    </ol>
  )}
</section>

<style>
  .group { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
  .group-heading { margin: 0; }
  .empty { padding: 48px 0; border-top: 1px solid var(--color-rule-soft); border-bottom: 1px solid var(--color-rule-soft); }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-rule); }
  .list a {
    display: grid; grid-template-columns: 80px minmax(0, 1fr) minmax(0, 1fr);
    gap: 8px 24px; align-items: baseline;
    padding: 18px 0; border-bottom: 1px solid var(--color-rule-soft);
  }
  .entry-title { font-family: var(--font-display); font-weight: var(--weight-subhead); font-size: 24px; line-height: 1.2; }
  .ext { font-size: 16px; }
  .summary { color: var(--color-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 720px) { .list a { grid-template-columns: 1fr; } }
</style>
