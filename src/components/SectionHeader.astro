---
// Top bar on inner pages: back-to-home + section links.
import { site, sections, type SectionSlug } from '../data/site';
interface Props { current?: SectionSlug }
const { current } = Astro.props;
---
<header class="bar label">
  <a href="/">← {site.name}</a>
  <nav aria-label="Sections">
    {sections.map((s) => (
      <a href={`/${s.slug}/`} aria-current={s.slug === current ? 'page' : undefined}>{s.title}</a>
    ))}
  </nav>
</header>

<style>
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }
  nav { display: flex; flex-wrap: wrap; gap: 8px 24px; }
</style>
